rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Citizen photo/voice uploads: authenticated users can upload to their own folder
    match /voice/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && request.resource.contentType.matches('audio/.*');
    }

    match /photos/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024  // 15 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // Seed data bucket — read-only for authenticated, write for admin
    match /seed/{allPaths=**} {
      allow read: if request.auth != null;
    }
  }
}
